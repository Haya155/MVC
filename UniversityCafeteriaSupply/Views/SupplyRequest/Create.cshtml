
@model SupplyRequest

@{
    ViewData["Title"] = "Create SupplyRequest";
}

<div class="container mt-4">

    <h2 class="mb-4">Create SupplyRequest</h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <input asp-for="Status" class="form-control" />
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RequestDate" class="form-label">Request Date</label>
            <input asp-for="RequestDate" type="date" class="form-control" />
            <span asp-validation-for="RequestDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TotalPrice" class="form-label">Total Price</label>
            <input asp-for="TotalPrice" class="form-control" />
            <span asp-validation-for="TotalPrice" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>

        <a asp-action="Index" class="btn btn-secondary">Back</a>

    </form>

</div>

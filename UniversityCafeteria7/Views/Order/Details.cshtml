
@model Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">

    <h2 class="mb-4">Order Details</h2>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            Order not found.
        </div>
    }
    else
    {
        <dl class="row card card-body shadow-sm">

            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Customer Name</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3">Order Date</dt>
            <dd class="col-sm-9">@Model.OrderDate</dd>

            <dt class="col-sm-3">Total Price</dt>
            <dd class="col-sm-9">@Model.TotalPrice</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Employee ID</dt>
            <dd class="col-sm-9">@Model.EmployeeId</dd>

        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-primary">Edit</a>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to list</a>

</div>

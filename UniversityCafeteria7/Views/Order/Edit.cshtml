
@model Order

@{
    ViewData["Title"] = "Edit Order";
}

<div class="container mt-4">

    <h2 class="mb-4">Edit Order</h2>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label">Customer Name</label>
            <input asp-for="CustomerName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="OrderDate" class="form-label">Order Date</label>
            <input asp-for="OrderDate" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="TotalPrice" class="form-label">Total Price</label>
            <input asp-for="TotalPrice" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <input asp-for="Status" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EmployeeId" class="form-label">Employee</label>
            <select asp-for="EmployeeId" class="form-select"
                    asp-items="ViewBag.EmployeeId">
                <option value="">Select Employee</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>

    </form>

</div>

@model IEnumerable<UniversityCafeteria5.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

<p>
    @Html.ActionLink("Create New Product", "Create", "Product", null,
        new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>CategoryId</th>
            <th>SupplierId</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@item.CategoryId</td>
                <td>@item.SupplierId</td>
            </tr>
        }
    </tbody>
</table>

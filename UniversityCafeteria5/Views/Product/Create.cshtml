@model UniversityCafeteria5.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<h2>Create Product</h2>

<form method="post" asp-action="Create" asp-controller="Product">

    <label>Name:</label>
    <input type="text" name="Name" />

    <br />

    <label>Price:</label>
    <input type="number" step="0.01" name="Price" />

    <br />

    <label>Quantity:</label>
    <input type="number" name="Quantity" />

    <br />
    <label asp-for="CategoryId" class="form-label">Category</label>
    <select asp-for="CategoryId" class="form-select"
            asp-items="ViewBag.CategoryId">
        <option value="">Select Category</option>
    </select>
    <br />

    <label asp-for="SupplierId" class="form-label">Supplier</label>
    <select asp-for="SupplierId" class="form-select"
            asp-items="ViewBag.SupplierId">
        <option value="">Select Supplier</option>
    </select>

    <br />

    <button type="submit">Create</button>

</form>
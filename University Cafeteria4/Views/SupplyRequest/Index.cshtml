@{
    ViewData["Title"] = "Create Supply Request";
    string preferredPriority = ViewData["PreferredPriority"]?.ToString();
    List<string[]> items = (List<string[]>)ViewData["Items"];
}

<div class="container mt-4">
    <h2>Create Supply Request</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (!string.IsNullOrEmpty(preferredPriority))
    {
        <div class="alert alert-info">Your preferred request priority is <strong>@preferredPriority</strong>.</div>
    }

    @if (items != null && items.Count > 0)
    {
        <h4 class="mt-3">Current Request Products</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item[0]</td>
                        <td>@item[1]</td>
                        <td>@item[2]</td>
                        <td>@item[3] JD</td>
                        <td>@item[4] JD</td>
                    </tr>
                }
            </tbody>
        </table>
        <a class="btn btn-success" href="@Url.Action("Review", "SupplyRequest")">Review Request</a>
    }

    <!-- Form 1: Add Item -->
    <form asp-action="AddItem" method="post" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input type="text" name="productName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="category" class="form-control" required>
                <option value="Beverages">Beverages</option>
                <option value="Food">Food</option>
                <option value="Packaging">Packaging</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Quantity</label>
            <input type="number" name="quantity" class="form-control" min="1" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Unit Price (JD)</label>
            <input type="number" step="0.01" name="unitPrice" class="form-control" min="0.01" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-select">
                <option value="Normal" selected="@(preferredPriority == "Normal")">Normal</option>
                <option value="Urgent" selected="@(preferredPriority == "Urgent")">Urgent</option>
                <option value="Emergency" selected="@(preferredPriority == "Emergency")">Emergency</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Add Product</button>
    </form>

    <hr class="my-4" />


    <h3>Set Preferred Priority</h3>
    <form asp-action="SavePreference" method="post" class="mt-3">
        <div class="mb-3">
            <label class="form-label">Default Priority Preference:</label>
            <select name="priority" class="form-select">
                <option value="Normal">Normal</option>
                <option value="Urgent">Urgent</option>
                <option value="Emergency">Emergency</option>
            </select>
        </div>
        <button type="submit" class="btn btn-secondary">Save Preference</button>
    </form>
</div>
@{
    ViewData["Title"] = "Review Request";
    List<string[]> items = (List<string[]>)ViewData["Items"];
    decimal subtotal = Convert.ToDecimal(ViewData["Subtotal"] ?? 0);
    string priority = ViewData["Priority"]?.ToString() ?? "Normal";
    decimal prepFee = Convert.ToDecimal(ViewData["PrepFee"] ?? 0);
    decimal discount = Convert.ToDecimal(ViewData["Discount"] ?? 0);
    decimal finalTotal = Convert.ToDecimal(ViewData["FinalTotal"] ?? 0);
}

<div class="container mt-4">
    <h2>Review Supply Request</h2>

    @if (items == null || items.Count == 0)
    {
        <div class="alert alert-warning mt-3">No products in the draft request yet.</div>
        <a class="btn btn-primary" href="@Url.Action("Index", "SupplyRequest")">Add Products</a>
    }
    else
    {
        <h4 class="mt-3">Products</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item[0]</td>
                        <td>@item[1]</td>
                        <td>@item[2]</td>
                        <td>@item[3] JD</td>
                        <td>@item[4] JD</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="mt-3">Calculation Details</h4>
        <table class="table table-bordered">
            <tr>
                <td>Subtotal</td>
                <td>@subtotal JD</td>
            </tr>
            <tr>
                <td>Preparation Fee (@priority)</td>
                <td>@prepFee JD</td>
            </tr>
            <tr>
                <td>Discount</td>
                <td>@discount JD</td>
            </tr>
            <tr>
                <th>Final Total</th>
                <th>@finalTotal JD</th>
            </tr>
        </table>

        <div class="d-flex gap-2">
            <form asp-action="ConfirmRequest" method="post">
                <button type="submit" class="btn btn-success">Confirm Request</button>
            </form>
            <form asp-action="ClearDraft" method="post">
                <button type="submit" class="btn btn-danger">Clear Draft</button>
            </form>
            <a class="btn btn-secondary" href="@Url.Action("Index", "SupplyRequest")">Add More Products</a>
        </div>
    }
</div>

@using AcademyGraduationPreparation.Models;
@model List<Offer>

@{
    ViewData["Title"] = "Review Request";

    var offerTotals = ViewBag.OfferTotals as List<decimal>;
}

<h2>Review Graduation Supply Request</h2>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Category</th>
            <th>Supplier</th>
            <th>Offer Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total Price</th>
        </tr>
    </thead>

    <tbody>

        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@Model[i].Category</td>
                <td>@Model[i].SupplierName</td>
                <td>@Model[i].OfferName</td>
                <td>@Model[i].Quantity</td>
                <td>@Model[i].UnitPrice JD</td>
                <td>@offerTotals[i] JD</td>
            </tr>
        }

    </tbody>

</table>

<hr />

<h4>Request Summary</h4>

<p>
    <strong>Total Price:</strong>
    @ViewBag.TotalPrice JD
</p>

<p>
    <strong>Discount Percentage:</strong>
    @ViewBag.DiscountPercentage%
</p>

<p>
    <strong>Discount Amount:</strong>
    @ViewBag.DiscountAmount JD
</p>

<h4>
    Final Total: @ViewBag.FinalTotal JD
</h4>

<a href="@Url.Action("Index", "SupplyRequest")"
   class="btn btn-primary">
    Back to Offers
</a>
